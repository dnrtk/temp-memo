# docker compose が自動で読み込む設定
# 公開ポート(ホスト側)。VoxCPM2_server(8080)・Dify(8081)と併走できるよう 8082
PORT=8082
# 127.0.0.1 = このPCのみ / 0.0.0.0 = LANからも到達可(認証なしなので注意)
BIND_ADDR=127.0.0.1
# 推論スレッド数。物理コア数が目安(Ryzen 7 5700X なら 8)
THREADS=8
# エンジンのイメージ。再現性を重視するなら cpu-latest をダイジェスト固定にする(README「ライセンス」参照)
AIVIS_IMAGE=ghcr.io/aivis-project/aivisspeech-engine:cpu-latest
# 既定の話者(声モデルの話者名)とスタイル。GET /v1/audio/speech/models で一覧が見られる
# 同梱の既定モデルは ACML 1.0(商用可・禁止事項あり)。変更時は必ず README「ライセンス」を確認
DEFAULT_SPEAKER=阿井田 茂
DEFAULT_STYLE=Heavy
# 声の調整の既定値(リクエストで省略されたときに使う。リクエストの指定が優先。空ならエンジンの既定)
# 落ち着いた声: 話速 0.9 / 抑揚 0.8
# ピッチは指定しない(0 以外にすると追加の信号処理で RTF が約 0.5 悪化し、音質も劣化することがある)
DEFAULT_SPEED=0.9
DEFAULT_INTONATION_SCALE=0.8
DEFAULT_TEMPO_DYNAMICS_SCALE=
DEFAULT_PITCH_SCALE=
DEFAULT_VOLUME_SCALE=
# 出力サンプルレート。VoxCPM2_server と同じ 48000 に揃える。空ならエンジンのネイティブ(44100)
OUTPUT_SAMPLE_RATE=48000
# 出力音量(RMS, dBFS)。空なら無効。-20 が目安
OUTPUT_RMS_DBFS=-20
# ライセンスゲート: 合成を許可する声モデルのライセンス(先頭行の接頭辞)。; 区切り。一致しないモデルは 403 で拒否
# 既定は ACML のみ。ACML-NC(非営利)や不明なライセンスは拒否される。広げる場合は各ライセンス条文を確認すること
LICENSE_ALLOW='# Aivis Common Model License (ACML)'
