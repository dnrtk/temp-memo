# docker compose が自動で読み込む設定
# 公開ポート(ホスト側)
PORT=8080
# 127.0.0.1 = このPCのみ / 0.0.0.0 = LANからも到達可(認証なしなので注意)
BIND_ADDR=127.0.0.1
# 推論スレッド数。物理コア数が目安(Ryzen 7 5700X なら 8)
THREADS=8
# VoxCPM2-BaseLM-Q8_0.gguf(既定) | VoxCPM2-BaseLM-F16.gguf(要ダウンロード)
BASELM_FILE=VoxCPM2-BaseLM-Q8_0.gguf
# 音声キャッシュ: 1=有効 / 0=無効(全リクエストを上流へ中継)
CACHE_ENABLED=1
# キャッシュ容量の上限(MB)。超えたら最終利用が古いものから削除(pinned は除く)
CACHE_MAX_MB=1024
# キャッシュ置き場(ホスト側のフォルダ)。音声ファイルと管理表 index.jsonl が入る
CACHE_DIR=./cache
# サーバへの追加引数(通常は空)
EXTRA_ARGS=
# HTTPワーカー数。1 固定を推奨(README「設計上の注意」参照)
HTTP_THREADS=1
